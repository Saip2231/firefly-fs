{
  "name": "firefly-pipeline-visualizer",
  "private": true,
  "version": "1.0.0",
  "description": "Animated protocol diagram for the Protocol page. Built into app/assets/pipeline/index.html (one self-contained file); Streamlit embeds that file, so the app needs no Node at runtime.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/copy-fonts.mjs",
    "build": "tsc --noEmit && node scripts/copy-fonts.mjs && vite build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.0.0",
    "@fontsource-variable/sora": "^5.0.0",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  }
}
